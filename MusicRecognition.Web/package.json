    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "4.6.2",
    "opensheetmusicdisplay": "2.2.1",
    "pdfjs-dist": "6.4.299",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@nuxt/eslint": "1.17.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
