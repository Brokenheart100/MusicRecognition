{
  "name": "pujian-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "predev": "node scripts/prepare-pdfjs.mjs",
    "dev": "nuxt dev --host 0.0.0.0",
    "prebuild": "node scripts/prepare-pdfjs.mjs",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "prepare": "node scripts/prepare-pdfjs.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "api:pull": "node scripts/pull-openapi.mjs",
